{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalPassThroughEnv": [
    "SKIP_ENV_VALIDATION",
    "DATABASE_URL",
    "DATABASE_URL_DIRECT",
    "PAYLOAD_SECRET",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_REGION",
    "S3_FORCE_PATH_STYLE",
    "S3_RAW_BUCKET",
    "MEDIA_PUBLIC_URL",
    "JOBS_MODE",
    "JOBS_SECRET",
    "TELEGRAM_BOT_TOKEN",
    "TELEGRAM_CHANNEL_LATN",
    "TELEGRAM_CHANNEL_CYRL",
    "TELEGRAM_ALERT_CHAT_ID",
    "PEXELS_API_KEY",
    "INDEXNOW_KEY",
    "API_KEY_RATE_LIMIT_PER_MIN",
    "MCP_MEDIA_UPLOADS_PER_HOUR",
    "MCP_MEDIA_FETCH_TIMEOUT_MS",
    "MCP_MEDIA_CONNECT_TIMEOUT_MS",
    "SENTRY_DSN",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "PAYLOAD_MIGRATING",
    "ENABLE_STYLEGUIDE",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_DEPLOYMENT_ID",
    "VERCEL_GIT_COMMIT_SHA"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NEXT_PUBLIC_*", "MEDIA_PUBLIC_URL", "S3_ENDPOINT", "SENTRY_DSN", "VERCEL_ENV"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
