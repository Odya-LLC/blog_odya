{
  "name": "@blog-odya/web",
  "version": "0.1.0",
  "private": true,
  "description": "Blog Odya: Next.js + Payload CMS — sayt, admin, REST/GraphQL, MCP, jobs",
  "type": "module",
  "scripts": {
    "dev": "pnpm run migrate && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "test:e2e": "playwright test",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_MIGRATING=true payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_MIGRATING=true payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation PAYLOAD_MIGRATING=true payload migrate:status",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "pnpm run migrate && cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/run.ts"
  },
  "dependencies": {
    "@blog-odya/guidelines": "workspace:*",
    "@blog-odya/shared": "workspace:*",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-nested-docs": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cross-env": "7.0.3",
    "graphql": "16.14.2",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rss-parser": "3.13.0",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "24.13.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "16.4.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "fast-xml-parser": "5.11.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  }
}
