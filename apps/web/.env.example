# Blog Odya — muhit o'zgaruvchilari (TZ §3.7.3). Sxema: apps/web/src/env.schema.ts
#
# Lokal ishga tushirish:  cp apps/web/.env.example apps/web/.env
# Quyidagi qiymatlar infra/docker-compose.dev.yml (Postgres + MinIO) bilan ishlaydi.
# Production qiymatlari — faqat Vercel Environment Variables (Production scope) va GitHub
# secrets'da. Staging yo'q: Preview scope'ga DB/R2 sirlarini qo'ymang (preview build ularsiz o'tadi).
# HECH QACHON haqiqiy sirlarni bu faylga yoki repo'ga yozmang.
#
# [majburiy]   — runtime'da (next start / dev / Vercel funksiyalari) bo'lmasa ilova ishga
#                tushmaydi. `next build` uchun majburiy emas (build DB/R2 ga ulanmaydi);
#                migratsiya (`pnpm migrate`) uchun faqat DATABASE_URL majburiy.
# [ixtiyoriy]  — bo'lmasa tegishli funksiya o'chiq yoki default ishlatiladi

# ---------------------------------------------------------------------------
# Ma'lumotlar bazasi (PostgreSQL)
# ---------------------------------------------------------------------------
# [majburiy] Runtime ulanish (pool.max = 3). Supabase'da — Supavisor transaction pooler (port 6543):
#   postgresql://postgres.<ref>:<parol>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/blog_odya
# [ixtiyoriy] Migratsiyalar uchun ulanish. Supabase'da — Supavisor SESSION pooler (port 5432):
#   postgresql://postgres.<ref>:<parol>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   Direct host (db.<ref>.supabase.co) faqat IPv6 — GitHub runner/Vercel'da ENOTFOUND.
#   Prod: GitHub secret DATABASE_URL_DIRECT_PROD (.github/workflows/migrate-prod.yml).
#   Bo'lmasa DATABASE_URL ishlatiladi.
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5442/blog_odya

# ---------------------------------------------------------------------------
# Payload CMS
# ---------------------------------------------------------------------------
# [majburiy] Kamida 32 belgi. Production uchun: openssl rand -hex 32
PAYLOAD_SECRET=local-dev-only-change-me-0123456789abcdef

# ---------------------------------------------------------------------------
# S3-mos saqlash: lokal — MinIO, production — Cloudflare R2 (farq faqat shu qiymatlarda)
# ---------------------------------------------------------------------------
# [majburiy] R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9010
# [majburiy] Media bucket (lokal init konteyner media, raw, backups ni yaratadi)
S3_BUCKET=media
# [majburiy] R2 API token (Access Key ID / Secret Access Key)
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# [ixtiyoriy, default: auto] R2 — auto, MinIO — us-east-1
S3_REGION=us-east-1
# [ixtiyoriy, default: false] MinIO va R2 uchun true
S3_FORCE_PATH_STYLE=true
# [ixtiyoriy, production'da majburiy] Scraping arxivi (raw/clean HTML, gzip) uchun YOPIQ bucket
#   (ommaviy o'qishsiz!). R2: blog-odya-raw + lifecycle rule 30 kun. Bo'lmasa scrapeItem
#   (item.fetch → item.extract) navbati ishga tushirilmaydi — job'lar navbatda kutadi.
S3_RAW_BUCKET=raw
# [ixtiyoriy] Media fayllarning ommaviy URL'i. Production: https://media.odya.uz
#   Admin'dan yuklash clientUploads bilan to'g'ridan-to'g'ri bucket'ga — R2'da CORS kerak
#   (docs/runbooks/r2-cors.md); MinIO'da docker-compose'da yoqilgan.
#   Bo'lmasa fayllar Payload orqali (/api/media/file/...) beriladi.
MEDIA_PUBLIC_URL=http://localhost:9010/media

# ---------------------------------------------------------------------------
# Sayt
# ---------------------------------------------------------------------------
# [ixtiyoriy, default: http://localhost:3000] Production: https://blog.odya.uz
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# [ixtiyoriy] 1 — qidiruv tizimlari uchun yopiq: robots.txt `Disallow: /`, barcha sahifalarda
#   `noindex` va `X-Robots-Tag` (staging uchun). Vercel'da kerak emas: VERCEL_ENV=preview
#   avtomatik yopiq, faqat production ochiq (src/site/seo/config.ts).
# SEO_NOINDEX=1

# ---------------------------------------------------------------------------
# Fon vazifalar (Payload Jobs)
# ---------------------------------------------------------------------------
# [ixtiyoriy, default: endpoint] endpoint — pg_cron /api/jobs/run ni chaqiradi (Vercel);
#   autorun — doimiy worker jarayoni (Contabo)
JOBS_MODE=endpoint
# [ixtiyoriy, production'da majburiy] /api/jobs/run uchun Bearer token, 32+ belgi
#   (openssl rand -hex 32). Bo'lmasa endpoint yopiq (503). Supabase Vault'dagi sir bilan bir xil
#   bo'lishi kerak — docs/runbooks/jobs-scheduler.md. Lokal sinov:
#   curl -X POST -H "Authorization: Bearer $JOBS_SECRET" http://localhost:3000/api/jobs/run
JOBS_SECRET=

# ---------------------------------------------------------------------------
# Telegram (bo'lmasa avtopost va ogohlantirishlar o'chiq — faqat log)
# ---------------------------------------------------------------------------
# [ixtiyoriy] @BotFather tokeni
TELEGRAM_BOT_TOKEN=
# [ixtiyoriy] Lotin kanal, masalan @blogodya
TELEGRAM_CHANNEL_LATN=
# [ixtiyoriy] Kirill kanal, masalan @blogodya_kr
TELEGRAM_CHANNEL_CYRL=
# [ixtiyoriy] Admin ogohlantirish guruhi chat ID (masalan -100...)
TELEGRAM_ALERT_CHAT_ID=

# ---------------------------------------------------------------------------
# Stok rasmlar (MCP search_stock_images, OBLOG-44)
# ---------------------------------------------------------------------------
# [ixtiyoriy] Pexels API kaliti (https://www.pexels.com/api/); bo'lmasa search_stock_images
#   "sozlanmagan" xatosini qaytaradi (upload_media va list_media ishlayveradi)
PEXELS_API_KEY=

# ---------------------------------------------------------------------------
# API kalit va MCP limitlari (OBLOG-45) — admin roli kalitlariga qo'llanmaydi
# ---------------------------------------------------------------------------
# [ixtiyoriy] Bitta API kalit uchun daqiqasiga so'rovlar (REST, GraphQL, MCP). Musbat butun son;
#   bo'sh yoki 0 — standart 60 (editor uchun limitni env orqali o'chirib bo'lmaydi)
API_KEY_RATE_LIMIT_PER_MIN=
# [ixtiyoriy] MCP upload_media: bitta foydalanuvchi uchun soatiga yuklashlar. Bo'sh yoki 0 — standart 30
MCP_MEDIA_UPLOADS_PER_HOUR=
# [ixtiyoriy] MCP upload_media(url): rasm tanasini yuklab olish timeout'i, ms. Bo'sh yoki 0 — standart 45000
#   (umumiy yuklab olish byudjeti baribir <= 90 s — /api/mcp maxDuration = 120 s ichida)
MCP_MEDIA_FETCH_TIMEOUT_MS=
# [ixtiyoriy] MCP upload_media(url): DNS + ulanish + javob sarlavhalari (har redirect uchun), ms.
#   Bo'sh yoki 0 — standart 10000. Javob bermayotgan host shu vaqtda rad etiladi
MCP_MEDIA_CONNECT_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
# [ixtiyoriy] Sentry DSN; bo'lmasa Sentry o'chiq
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Build / CI
# ---------------------------------------------------------------------------
# [ixtiyoriy] 1 — env tekshiruvini butunlay o'tkazib yuborish. `next build` uchun odatda kerak
#   emas: build fazasida sirlar/DB majburiy emas, faqat berilgan qiymatlar formati tekshiriladi.
# SKIP_ENV_VALIDATION=1
