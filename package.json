{
  "name": "blog-odya",
  "private": true,
  "description": "Blog Odya (OBLOG) — AI, IT, texnologiya va kibersport yangiliklari o'zbek tilida",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "pnpm --filter @blog-odya/web migrate",
    "migrate:create": "pnpm --filter @blog-odya/web migrate:create",
    "payload": "pnpm --filter @blog-odya/web payload"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "prettier": "3.9.9",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1"
  }
}
